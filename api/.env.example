PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/card_dev
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The address the phone uses to reach this API (use your machine's LAN IP for a physical device)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. card:// is the mobile app's deep-link scheme.
TRUSTED_ORIGINS=card://

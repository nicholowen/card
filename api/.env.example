PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/card_dev
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The address the phone uses to reach this API (use your machine's LAN IP for a physical device)
BETTER_AUTH_URL=http://localhost:3000
# Extra comma-separated origins to trust. The app's card:// scheme is always
# trusted, and Expo Go's exp:// is trusted unless NODE_ENV=production.
TRUSTED_ORIGINS=card://

# Google sign-in (optional; left blank, the app's Google button reports it's unavailable).
# A "Web application" OAuth client in Google Cloud Console, with this authorised
# redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional). All three are needed.
# APPLE_SERVICE_ID: a Services ID with return URL <BETTER_AUTH_URL>/api/auth/callback/apple (https only).
# APPLE_CLIENT_SECRET: a JWT signed with your Sign in with Apple key. It expires after
#   at most six months, so it must be regenerated before then.
# APPLE_APP_BUNDLE_IDENTIFIER: the iOS bundle ID (mobile/app.json), for native sign-in on iPhone.
APPLE_SERVICE_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=com.owennicholson.card

# Cloud Parse (optional; left blank, the app parses cards on the device).
# A Claude API key from https://platform.claude.com (Settings > API keys).
# Check it works with: npm run check-llm -w api
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=
